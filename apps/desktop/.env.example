# Stripe Configuration
# Get these values from https://dashboard.stripe.com/

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (starts with whsec_)
# Create a webhook endpoint at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for monthly and annual plans
# Create products and prices at https://dashboard.stripe.com/products
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# License Signing (server-side only, never ship in client)
# Used by the license generation service to sign license files
LICENSE_PRIVATE_KEY=457aeac3e2d6518632d1b5549b8e526ae94d320d078263daf9807b1b07470a0d

# Development Mode
NODE_ENV=development
