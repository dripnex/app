---
import { Icon } from 'astro-icon/components';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
---

<section class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <!-- CTA -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-zinc-50 mb-4">Ready to own your notes?</h2>
      <p class="text-lg text-[#a1a1aa] mb-8 max-w-[48ch] mx-auto">Download for free. No account. No credit card. Just open a folder and start writing.</p>

      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center mb-8">
        <a
          href="/download"
          class="group inline-flex w-full items-center justify-center gap-3 rounded-lg bg-accent px-7 py-3.5 text-base font-medium text-white transition-colors hover:bg-accent-hover sm:w-auto"
        >
          <Icon name="lucide:download" class="h-5 w-5" />
          Download Free
        </a>
        <a
          href="/pricing"
          class="inline-flex w-full items-center justify-center rounded-lg border border-white/[0.08] px-7 py-3.5 text-base font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-white sm:w-auto"
        >
          View pricing
        </a>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap justify-center gap-3">
        <div class="flex items-center gap-2 rounded-full border border-white/[0.06] bg-white/[0.03] px-4 py-2 text-sm text-[#71717a]">
          <Icon name="lucide:heart" class="h-3.5 w-3.5 text-accent" />
          <span>Free forever</span>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-white/[0.06] bg-white/[0.03] px-4 py-2 text-sm text-[#71717a]">
          <Icon name="lucide:zap" class="h-3.5 w-3.5 text-accent" />
          <span>{config.trialDays}-day Pro trial</span>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-white/[0.06] bg-white/[0.03] px-4 py-2 text-sm text-[#71717a]">
          <Icon name="lucide:wifi-off" class="h-3.5 w-3.5 text-accent" />
          <span>100% offline</span>
        </div>
      </div>
    </div>

    <!-- Indie developer card -->
    <div class="rounded-xl bg-surface p-6 md:p-8">
      <div class="flex flex-col md:flex-row items-start gap-6 md:gap-8">
        <!-- Photo -->
        <div class="shrink-0">
          <div class="w-24 h-24 md:w-28 md:h-28 rounded-xl bg-inset border border-white/[0.06] overflow-hidden flex items-center justify-center">
            <img
              src="https://avatars.githubusercontent.com/u/7626025?v=4"
              alt="Tomy Maritano"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Content -->
        <div class="flex flex-col gap-3 flex-1">
          <span class="font-mono text-sm font-bold uppercase tracking-[0.05em] text-accent">Built by an indie developer</span>
          <p class="text-lg leading-relaxed text-[#a1a1aa]">
            Readied is made by <strong class="text-[#f4f4f5] font-semibold">Tomy Maritano</strong>, a developer who cares about software longevity.
            No investors. No growth targets. Just a tool that works.
          </p>
          <a
            href="/philosophy"
            class="group mt-1 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors hover:text-accent-hover"
          >
            Read the philosophy
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
