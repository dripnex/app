---
import { Icon } from 'astro-icon/components';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
---

<section class="py-24 px-6">
  <div class="mx-auto max-w-4xl">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <!-- Left: CTA content -->
      <div class="flex flex-col gap-5 text-center lg:text-left">
        <span class="inline-block font-mono text-xs font-semibold uppercase tracking-widest text-accent">Made for developers</span>

        <h2 class="text-3xl font-bold leading-tight tracking-tight lg:text-4xl">
          Software that<br />
          <span class="text-accent">respects your time</span>
        </h2>

        <p class="mx-auto max-w-[44ch] text-lg leading-relaxed text-[#a1a1aa] lg:mx-0">
          No onboarding. No account required. No data collection.
          Download, open a folder, and start writing.
        </p>

        <div class="mt-2 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href="/download"
            class="inline-flex w-full items-center justify-center gap-3 rounded-lg bg-accent px-7 py-3.5 text-base font-medium text-white transition-colors hover:bg-accent-hover sm:w-auto"
          >
            <Icon name="lucide:download" class="h-5 w-5" />
            Start {config.trialDays}-day trial
          </a>
          <a
            href="/pricing"
            class="inline-flex w-full items-center justify-center rounded-lg border border-white/[0.08] px-7 py-3.5 text-base font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-white sm:w-auto"
          >
            View pricing
          </a>
        </div>

        <!-- Trust signals -->
        <div class="mt-4 flex flex-wrap justify-center gap-3 lg:justify-start">
          <div class="flex min-w-[120px] flex-1 flex-col items-center gap-1 rounded-xl bg-surface px-4 py-4 text-center sm:flex-initial sm:min-w-[100px]">
            <span class="font-mono text-xl font-bold text-accent">Free</span>
            <span class="whitespace-nowrap text-xs text-[#71717a]">forever</span>
          </div>
          <div class="flex min-w-[120px] flex-1 flex-col items-center gap-1 rounded-xl bg-surface px-4 py-4 text-center sm:flex-initial sm:min-w-[100px]">
            <span class="font-mono text-xl font-bold text-accent">{config.trialDays}</span>
            <span class="whitespace-nowrap text-xs text-[#71717a]">days Pro trial</span>
          </div>
          <div class="flex min-w-[120px] flex-1 flex-col items-center gap-1 rounded-xl bg-surface px-4 py-4 text-center sm:flex-initial sm:min-w-[100px]">
            <span class="font-mono text-xl font-bold text-accent">100%</span>
            <span class="whitespace-nowrap text-xs text-[#71717a]">Offline capable</span>
          </div>
        </div>
      </div>

      <!-- Right: Indie developer card -->
      <div class="rounded-xl bg-surface p-6 md:p-8">
        <!-- Heart icon box -->
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-accent/10 text-accent">
          <Icon name="lucide:heart" class="h-7 w-7" />
        </div>

        <div class="flex flex-col gap-4">
          <span class="font-mono text-sm font-bold uppercase tracking-[0.05em] text-accent">Built by an indie developer</span>
          <p class="text-lg leading-relaxed text-[#a1a1aa]">
            Readied is made by a single developer who cares about software longevity.
            No investors. No growth targets. Just a tool that works.
          </p>
          <a
            href="/philosophy"
            class="group mt-2 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors hover:text-accent-hover"
          >
            Read the philosophy
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
