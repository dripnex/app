---
import { Icon } from 'astro-icon/components';

const rows = [
  { feature: 'Cloud sync', reason: "Servers die. Local files don't." },
  { feature: 'Plugin ecosystems', reason: 'Plugins that change your files create lock-in.' },
  { feature: 'Custom syntax', reason: 'Your Markdown stays standard.' },
  { feature: 'AI features', reason: 'AI requires servers. Servers require trust.' },
  { feature: 'Real-time collab', reason: "Requires infrastructure we'd have to maintain." },
];
---

<section class="comparison">
  <div class="container">
    <header class="section-header">
      <span class="label">Constraints</span>
      <h2>What we <span class="text-gradient">don't</span> do</h2>
      <p class="section-lead">Intentional limitations that keep your data safe.</p>
    </header>

    <div class="table-container glass">
      <div class="table-header">
        <span class="col-feature">Feature</span>
        <span class="col-reason">Why we skip it</span>
      </div>
      <ul class="table-rows">
        {rows.map((row, i) => (
          <li class="table-row">
            <span class="cell cell-feature">
              <Icon name="lucide:x" size={16} />
              {row.feature}
            </span>
            <span class="cell cell-reason">{row.reason}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .comparison {
    padding: var(--space-24) 0;
    background: transparent;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .section-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .section-header h2 {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .section-lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .table-container {
    max-width: 720px;
    margin: 0 auto;
    overflow: hidden;
  }

  .table-header {
    display: grid;
    grid-template-columns: 200px 1fr;
    background: var(--glass-bg-dark);
    border-bottom: 1px solid var(--glass-border);
  }

  .table-header span {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .col-reason {
    border-left: 1px solid var(--glass-border);
  }

  .table-rows {
    list-style: none;
  }

  .table-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    border-bottom: 1px solid var(--glass-border);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .table-row:hover {
    background: var(--glass-bg-elevated);
  }

  .cell {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .cell-feature {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    font-weight: 500;
  }

  .cell-feature svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .cell-reason {
    color: var(--text-secondary);
    border-left: 1px solid var(--glass-border);
  }

  @media (max-width: 640px) {
    .comparison {
      padding: var(--space-16) 0;
    }

    .section-header h2 {
      font-size: var(--text-2xl);
    }

    .table-header {
      grid-template-columns: 1fr;
    }

    .table-header .col-reason {
      display: none;
    }

    .table-row {
      grid-template-columns: 1fr;
    }

    .cell-reason {
      border-left: none;
      border-top: 1px solid var(--glass-border);
      padding-top: var(--space-3);
    }
  }
</style>
