---
import { Icon } from 'astro-icon/components';

const decisions = [
  {
    title: 'No cloud',
    description: 'Your notes live on your machine.',
    tradeoff: 'No sync between devices.',
    icon: 'lucide:cloud-off'
  },
  {
    title: 'No implicit transforms',
    description: 'We never change your text without asking.',
    tradeoff: 'No auto-formatting.',
    icon: 'lucide:shield'
  },
  {
    title: 'No subscription',
    description: 'One payment. You own it.',
    tradeoff: 'Updates require annual renewal.',
    icon: 'lucide:badge-check'
  }
];
---

<section class="decisions">
  <div class="container">
    <header class="section-header" data-reveal="fade-up">
      <span class="label">Design decisions</span>
      <h2>Trade-offs we<br/><span class="text-gradient">chose carefully</span></h2>
      <p class="section-lead">Every capability has a cost. Here's what we prioritized.</p>
    </header>

    <div class="decisions-grid" data-stagger="120">
      {decisions.map((item, i) => (
        <article class="decision-card glass">
          <div class="card-icon">
            <Icon name={item.icon} size={24} />
          </div>
          <header class="card-header">
            <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
          </header>
          <p class="card-desc">{item.description}</p>
          <footer class="card-footer glass">
            <span class="tradeoff-label">Trade-off</span>
            <span class="tradeoff">{item.tradeoff}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .decisions {
    padding: var(--space-24) 0;
    background: transparent;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .section-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .section-header h2 {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .section-lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 40ch;
    margin: 0 auto;
  }

  .decisions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .decision-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    overflow: hidden;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg-accent);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--radius-md);
    color: var(--accent);
    margin-bottom: var(--space-6);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-index {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .card-header h3 {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .card-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-6);
  }

  .card-footer {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--glass-bg-dark);
    border: 1px solid var(--glass-border);
  }

  .tradeoff-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .tradeoff {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .decisions-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .decisions {
      padding: var(--space-16) 0;
    }

    .section-header h2 {
      font-size: var(--text-2xl);
    }

    .decision-card {
      padding: var(--space-6);
    }
  }
</style>
