---
import { Icon } from 'astro-icon/components';
import NewsletterForm from './NewsletterForm.tsx';

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-base border-t border-white/[0.06]">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-6 pb-8 pt-14 lg:px-8">
    <!-- Top row: brand -->
    <div class="flex flex-col gap-3">
      <a href="/" class="inline-block transition-opacity hover:opacity-75">
        <span class="font-mono text-xl font-bold text-zinc-50 tracking-tight">readied<span class="text-accent">.</span></span>
      </a>
      <p class="max-w-[260px] text-sm leading-relaxed text-[#71717a]">
        The note app that stays out of your way.
      </p>
    </div>

    <!-- Navigation columns -->
    <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Footer navigation">
      <!-- Product -->
      <div class="flex flex-col gap-2.5">
        <span class="mb-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[#71717a]">Product</span>
        <a href="/#features" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Features</a>
        <a href="/pricing" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Pricing</a>
        <a href="/download" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Download</a>
      </div>

      <!-- Resources -->
      <div class="flex flex-col gap-2.5">
        <span class="mb-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[#71717a]">Resources</span>
        <a href="https://tomymaritano.github.io/readide/" target="_blank" rel="noopener" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Docs</a>
        <a href="/changelog" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Changelog</a>
        <a href="/philosophy" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Philosophy</a>
        <a href="/faq" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">FAQ</a>
        <a href="https://github.com/tomymaritano/readide/issues/new?template=bug_report.md" target="_blank" rel="noopener" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Report a Bug</a>
        <a href="https://github.com/tomymaritano/readide/contribute" target="_blank" rel="noopener" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Contribute</a>
      </div>

      <!-- Legal -->
      <div class="flex flex-col gap-2.5">
        <span class="mb-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[#71717a]">Legal</span>
        <a href="/terms" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Terms</a>
        <a href="/privacy" class="w-fit text-sm text-[#a1a1aa] transition-colors hover:text-accent">Privacy</a>
      </div>

      <!-- Connect -->
      <div class="flex flex-col gap-2.5">
        <span class="mb-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[#71717a]">Connect</span>
        <a href="https://github.com/tomymaritano/readide" target="_blank" rel="noopener" aria-label="GitHub" class="inline-flex w-fit items-center gap-2 text-sm text-[#a1a1aa] transition-colors hover:text-accent">
          <Icon name="simple-icons:github" class="h-[18px] w-[18px] shrink-0" />
          <span>GitHub</span>
        </a>
        <a href="https://x.com/tomymaritano" target="_blank" rel="noopener" aria-label="X (Twitter)" class="inline-flex w-fit items-center gap-2 text-sm text-[#a1a1aa] transition-colors hover:text-accent">
          <Icon name="simple-icons:x" class="h-[18px] w-[18px] shrink-0" />
          <span>Twitter</span>
        </a>
      </div>
    </nav>
  </div>

  <!-- Bottom bar -->
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-4 border-t border-white/[0.06] px-6 py-5 sm:flex-row lg:px-8">
    <div class="flex items-center gap-4">
      <span class="text-xs text-[#71717a]">&copy; {year} Readied. Built with &hearts; for developers.</span>
    </div>
    <div class="w-full max-w-xs shrink-0">
      <NewsletterForm client:idle compact />
    </div>
  </div>
</footer>
