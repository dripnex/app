---
import { Icon } from 'astro-icon/components';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo-link">
        <img src="/logowhite.svg" alt="Readied" class="footer-logo" />
      </a>
      <span class="copyright">&copy; {year} Readied</span>
    </div>

    <nav class="footer-nav">
      <div class="footer-col">
        <span class="footer-col-title">Product</span>
        <a href="/download">Download</a>
        <a href="/pricing">Pricing</a>
        <a href="/changelog">Changelog</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Resources</span>
        <a href="/faq">FAQ</a>
        <a href="https://medium.com/@tomymaritano" target="_blank" rel="noopener">Blog</a>
        <a href="/philosophy">Philosophy</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Legal</span>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </nav>

    <div class="footer-social">
      <a href="https://github.com/tomymaritano/readide" target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="simple-icons:github" size={20} />
      </a>
      <a href="https://x.com/tomymaritano" target="_blank" rel="noopener" aria-label="X (Twitter)">
        <Icon name="simple-icons:x" size={20} />
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <span class="made-with">Made with care for developers who value their data.</span>
  </div>

  <div class="footer-glow"></div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: auto;
    padding: 0 var(--space-6);
    background: var(--glass-bg-dark);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    border-top: 1px solid var(--glass-border);
  }

  .footer-inner {
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-12) 0 var(--space-8);
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-12);
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-logo-link {
    display: inline-block;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .footer-logo-link:hover {
    opacity: 0.8;
  }

  .footer-logo {
    height: 20px;
    width: auto;
  }

  .copyright {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-12);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
  }

  .footer-social a {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .footer-social a:hover {
    color: var(--accent);
    border-color: var(--glass-border-accent);
    background: var(--glass-bg-accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--glass-border);
    padding: var(--space-4) var(--space-6);
    text-align: center;
  }

  .made-with {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .footer-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 50%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(94, 234, 212, 0.25) 50%,
      transparent 100%
    );
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      text-align: center;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-nav {
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-8);
    }

    .footer-col {
      align-items: center;
    }

    .footer-social {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding: 0 var(--space-4);
    }

    .footer-inner {
      padding: var(--space-8) 0 var(--space-6);
    }

    .footer-nav {
      gap: var(--space-6);
    }

    .footer-bottom {
      padding: var(--space-4);
    }
  }
</style>
