---
import { Icon } from 'astro-icon/components';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
---

<section class="relative pt-32 sm:pt-40 pb-20 lg:pb-24">
  <div class="relative z-[2] mx-auto w-full max-w-5xl px-6 lg:px-8">
    <div class="text-center">
      <!-- Version badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-2 text-xs font-medium text-[#a1a1aa] opacity-0 animate-fade-in-up">
        <span class="font-mono text-accent">v0.6</span>
        Early access
      </div>

      <!-- Headline -->
      <h1 class="mb-6 text-[clamp(2.5rem,5vw,4rem)] font-extrabold leading-[1.08] tracking-tight opacity-0 animate-fade-in-up [animation-delay:100ms]">
        Your Markdown.<br />
        <span class="gradient-text">Your Machine.</span><br />
        Your Rules.
      </h1>

      <!-- Subtext -->
      <p class="mx-auto mb-8 max-w-[540px] text-lg leading-relaxed text-[#a1a1aa] opacity-0 animate-fade-in-up [animation-delay:200ms]">
        A note app that doesn't phone home, doesn't lock you in, and doesn't need an internet connection. Just you, your files, and Markdown.
      </p>

      <!-- Dual CTAs -->
      <div class="mb-8 flex flex-col items-center gap-4 opacity-0 animate-fade-in-up [animation-delay:300ms] sm:flex-row sm:justify-center">
        <a href="/download" class="group inline-flex w-full items-center justify-center gap-3 rounded-lg bg-accent px-7 py-3.5 text-base font-medium text-white transition-colors hover:bg-accent-hover sm:w-auto">
          <Icon name="lucide:download" class="h-5 w-5" />
          Download Free
        </a>
        <a href="/pricing" class="group inline-flex w-full items-center justify-center gap-2 rounded-lg border border-white/[0.08] px-7 py-3.5 text-base font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-white sm:w-auto">
          Start Pro Trial
          <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>

      <!-- Trust badges -->
      <div class="flex flex-col items-center gap-2 text-sm text-[#71717a] opacity-0 animate-fade-in-up [animation-delay:400ms] sm:flex-row sm:gap-3 sm:justify-center">
        <span class="inline-flex items-center gap-2">
          <Icon name="lucide:shield" class="h-3.5 w-3.5" />
          Offline-first
        </span>
        <span class="hidden text-white/20 sm:inline">&middot;</span>
        <span>macOS, Windows &amp; Linux</span>
        <span class="hidden text-white/20 sm:inline">&middot;</span>
        <span>Free forever &middot; Pro {config.trialDays}-day trial</span>
      </div>
    </div>

    <!-- Editor screenshot -->
    <div class="mt-16 opacity-0 animate-fade-in-up [animation-delay:500ms]">
      <div class="relative">
        <img
          src="/media/hero-editor.svg"
          alt="Readied editor showing a project roadmap in split Markdown and preview mode"
          class="w-full rounded-xl border border-white/[0.06] shadow-2xl shadow-accent/5"
          width="1280"
          height="720"
          loading="eager"
        />
        <!-- Glow effect behind image -->
        <div class="absolute -inset-4 -z-10 bg-accent/5 blur-3xl rounded-3xl"></div>
      </div>
    </div>
  </div>
</section>
