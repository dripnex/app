---
import MobileNav from './MobileNav.tsx';
import NavDropdown from './NavDropdown.tsx';
---

<header class="fixed top-0 inset-x-0 z-50 h-16 bg-zinc-950/80 backdrop-blur-xl border-b border-white/[0.06]">
  <div class="mx-auto flex h-full max-w-5xl items-center justify-between gap-8 px-6 lg:px-8">
    <!-- Text logo -->
    <a href="/" class="flex items-center">
      <span class="font-mono text-lg font-bold text-zinc-50 tracking-tight">readied<span class="text-accent">.</span></span>
    </a>

    <!-- Desktop nav links -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      <a
        href="/#features"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Features
      </a>
      <a
        href="/pricing"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Pricing
      </a>

      <NavDropdown
        client:load
        label="Docs"
        items={[
          { label: 'Documentation', href: 'https://tomymaritano.github.io/readide/' },
          { label: 'Philosophy', href: '/philosophy' },
          { label: 'FAQ', href: '/faq' },
          { label: 'Plugins', href: '/plugins' },
          { label: 'Report a Bug', href: 'https://github.com/tomymaritano/readide/issues/new?template=bug_report.md' },
        ]}
      />

      <a
        href="/changelog"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Changelog
      </a>
    </nav>

    <!-- Desktop dual CTAs -->
    <div class="hidden items-center gap-3 md:flex">
      <a
        href="/download"
        class="rounded-lg border border-white/[0.08] px-4 py-2 text-sm font-medium text-zinc-400 transition-colors hover:bg-white/5 hover:text-white"
      >
        Download
      </a>
      <a
        href="/pricing"
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
      >
        Try Pro Free &rarr;
      </a>
    </div>

    <!-- Mobile menu button -->
    <div class="flex md:hidden">
      <MobileNav
        client:load
        links={[
          { label: 'Download', href: '/download' },
          { label: 'Try Pro Free', href: '/pricing' },
        ]}
        sections={[
          {
            title: 'Product',
            links: [
              { label: 'Pricing', href: '/pricing' },
              { label: 'Changelog', href: '/changelog' },
            ],
          },
          {
            title: 'Resources',
            links: [
              { label: 'Documentation', href: 'https://tomymaritano.github.io/readide/', external: true },
              { label: 'Philosophy', href: '/philosophy' },
              { label: 'FAQ', href: '/faq' },
              { label: 'Plugins', href: '/plugins' },
              { label: 'Report a Bug', href: 'https://github.com/tomymaritano/readide/issues/new?template=bug_report.md', external: true },
              { label: 'Contribute', href: 'https://github.com/tomymaritano/readide/contribute', external: true },
              { label: 'Blog', href: 'https://medium.com/@tomymaritano', external: true },
            ],
          },
          {
            title: 'Community',
            links: [
              { label: 'GitHub', href: 'https://github.com/tomymaritano/readide', external: true },
              { label: 'X (Twitter)', href: 'https://x.com/tomymaritano', external: true },
            ],
          },
        ]}
      />
    </div>
  </div>
</header>
