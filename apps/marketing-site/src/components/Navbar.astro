---
import MobileNav from './MobileNav.tsx';
import NavDropdown from './NavDropdown.tsx';
---

<header class="fixed top-0 inset-x-0 z-50 h-14 bg-base border-b border-white/[0.06]">
  <div class="mx-auto flex h-full max-w-4xl items-center justify-between gap-8 px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center transition-opacity hover:opacity-80">
      <img src="/logowhite.svg" alt="Readied" class="h-[22px] w-auto" />
    </a>

    <!-- Desktop nav links -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      <a
        href="/philosophy"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Philosophy
      </a>
      <a
        href="/pricing"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Pricing
      </a>
      <a
        href="/plugins"
        class="relative rounded-lg px-3 py-2 text-sm font-medium text-[#a1a1aa] transition-colors hover:bg-white/5 hover:text-[#f4f4f5]"
      >
        Plugins
      </a>

      <NavDropdown
        client:load
        label="More"
        items={[
          { label: "What's New", href: '/changelog', icon: '\u{1F4CB}' },
          { label: 'FAQ', href: '/faq', icon: '\u{2753}' },
          { label: 'Blog', href: 'https://medium.com/@tomymaritano', icon: '\u{270F}\u{FE0F}', external: true },
          { label: 'GitHub', href: 'https://github.com/tomymaritano/readide', icon: '\u{1F4BB}', external: true },
          { label: 'X (Twitter)', href: 'https://x.com/tomymaritano', icon: '\u{1D54F}', external: true },
        ]}
      />
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden items-center gap-4 md:flex">
      <a
        href="/download"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Download
      </a>
    </div>

    <!-- Mobile menu button -->
    <div class="flex md:hidden">
      <MobileNav
        client:load
        links={[
          { label: 'Download', href: '/download' },
          { label: 'Pricing', href: '/pricing' },
          { label: 'Plugins', href: '/plugins' },
        ]}
        sections={[
          {
            title: 'Product',
            links: [
              { label: "What's New", href: '/changelog' },
            ],
          },
          {
            title: 'Resources',
            links: [
              { label: 'Philosophy', href: '/philosophy' },
              { label: 'FAQ', href: '/faq' },
              { label: 'Blog', href: 'https://medium.com/@tomymaritano', external: true },
            ],
          },
          {
            title: 'Community',
            links: [
              { label: 'GitHub', href: 'https://github.com/tomymaritano/readide', external: true },
              { label: 'X (Twitter)', href: 'https://x.com/tomymaritano', external: true },
            ],
          },
        ]}
      />
    </div>
  </div>
</header>
