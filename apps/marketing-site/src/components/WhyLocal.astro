---
import { Icon } from 'astro-icon/components';

const steps = [
  {
    number: '01',
    icon: 'lucide:folder-open',
    title: 'Open a folder',
    description: 'Point Readied at any folder on your computer. Your existing Markdown files appear instantly — no import, no conversion, no setup.'
  },
  {
    number: '02',
    icon: 'lucide:square-pen',
    title: 'Start writing',
    description: 'A focused editor with syntax highlighting, live preview, and keyboard shortcuts. Write in standard Markdown — the format that works everywhere.'
  },
  {
    number: '03',
    icon: 'lucide:hard-drive',
    title: 'Your files stay yours',
    description: 'Every note is a .md file on your disk. Open them in VS Code, sync them with Git, back them up however you want. No lock-in, ever.'
  }
];
---

<section class="py-24 px-6">
  <div class="mx-auto max-w-4xl">
    <!-- Section header -->
    <header class="mx-auto mb-16 max-w-[640px] text-center">
      <span class="mb-4 inline-block font-mono text-xs font-semibold uppercase tracking-widest text-accent">How it works</span>
      <h2 class="mb-5 text-3xl font-bold leading-tight tracking-tight lg:text-4xl">
        Three steps.<br />
        <span class="text-accent">Zero friction.</span>
      </h2>
      <p class="text-lg leading-relaxed text-[#a1a1aa]">
        No account. No onboarding. No cloud. Just open a folder and write.
      </p>
    </header>

    <!-- Steps -->
    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((step) => (
        <article class="rounded-xl bg-surface p-6 md:p-8 flex flex-col">
          <!-- Step number + icon -->
          <div class="flex items-center gap-4 mb-5">
            <span class="font-mono text-2xl font-bold text-accent/30">{step.number}</span>
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent/10 text-accent">
              <Icon name={step.icon} class="h-5 w-5" />
            </div>
          </div>

          <h3 class="text-lg font-semibold text-[#f4f4f5] mb-3">{step.title}</h3>
          <p class="text-sm leading-relaxed text-[#a1a1aa] flex-1">{step.description}</p>
        </article>
      ))}
    </div>

    <!-- Visual: file format proof -->
    <div class="mt-10 rounded-xl bg-surface overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <!-- Left: what you write -->
        <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-white/[0.06]">
          <div class="flex items-center gap-2 mb-4">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">What you write</span>
          </div>
          <div class="font-mono text-xs sm:text-sm leading-relaxed text-[#a1a1aa] space-y-1 bg-inset rounded-lg p-4 border border-white/[0.06]">
            <div><span class="text-accent font-bold"># </span><span class="text-[#f4f4f5] font-bold">Meeting Notes</span></div>
            <div class="h-1"></div>
            <div><span class="text-accent/50">- </span>Decided on local-first architecture</div>
            <div><span class="text-accent/50">- </span>Launch timeline: Q2 2026</div>
            <div><span class="text-accent/50">- </span>Next step: prototype by Friday</div>
          </div>
        </div>

        <!-- Right: what's on disk -->
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">What's on your disk</span>
          </div>
          <div class="font-mono text-xs sm:text-sm text-[#a1a1aa] space-y-0.5 bg-inset rounded-lg p-4 border border-white/[0.06]">
            <div class="flex items-center gap-2">
              <Icon name="lucide:folder-open" class="h-3.5 w-3.5 text-accent" />
              <span class="text-[#f4f4f5]">~/notes/</span>
            </div>
            <div class="flex items-center gap-2 pl-5">
              <Icon name="lucide:file-text" class="h-3.5 w-3.5 text-[#71717a]" />
              <span>meeting-notes.md</span>
              <span class="text-[10px] text-[#71717a] ml-auto">1.2 KB</span>
            </div>
            <div class="flex items-center gap-2 pl-5">
              <Icon name="lucide:file-text" class="h-3.5 w-3.5 text-[#71717a]" />
              <span>project-plan.md</span>
              <span class="text-[10px] text-[#71717a] ml-auto">3.4 KB</span>
            </div>
            <div class="flex items-center gap-2 pl-5">
              <Icon name="lucide:file-text" class="h-3.5 w-3.5 text-[#71717a]" />
              <span>ideas.md</span>
              <span class="text-[10px] text-[#71717a] ml-auto">0.8 KB</span>
            </div>
          </div>
          <p class="mt-3 text-xs text-[#71717a] italic">Plain .md files. Open with any editor.</p>
        </div>
      </div>
    </div>
  </div>
</section>
