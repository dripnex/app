---
import { Icon } from 'astro-icon/components';

const comparisons = [
  {
    cloud: "Files stored on someone else's server",
    local: 'Files on your disk, in folders you control'
  },
  {
    cloud: 'Requires internet to access your notes',
    local: 'Works offline, always'
  },
  {
    cloud: 'Proprietary format, export "when available"',
    local: 'Standard Markdown, open with any editor'
  },
  {
    cloud: 'Company pivots, your data migrates',
    local: 'Your files stay exactly where they are'
  }
];
---

<section class="py-24 px-6">
  <div class="mx-auto max-w-4xl">
    <!-- Section header -->
    <header class="mx-auto mb-16 max-w-[640px] text-center">
      <span class="mb-4 inline-block font-mono text-xs font-semibold uppercase tracking-widest text-accent">Why local-first</span>
      <h2 class="mb-5 text-3xl font-bold leading-tight tracking-tight lg:text-4xl">
        Your notes shouldn't<br />
        <span class="text-accent">depend on us</span>
      </h2>
      <p class="text-lg leading-relaxed text-[#a1a1aa]">
        Cloud apps come and go. Business models change. Servers shut down.
        But a folder of Markdown files? That works forever.
      </p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[1fr_1.4fr]">
      <!-- Risks card -->
      <div class="rounded-xl bg-surface p-6">
        <!-- Warning header -->
        <div class="mb-5 flex items-center gap-3">
          <Icon name="lucide:alert-triangle" class="h-5 w-5 shrink-0 text-red-400" />
          <span class="text-sm leading-snug text-[#a1a1aa]">With cloud apps, you're always one email away from:</span>
        </div>

        <!-- Risk items grid -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="flex items-center gap-3 rounded-lg border border-red-400/[0.12] bg-red-400/[0.06] px-4 py-3">
            <Icon name="lucide:server" class="h-[18px] w-[18px] shrink-0 text-red-400" />
            <span class="text-sm font-medium text-[#a1a1aa]">Server shutdown</span>
          </div>
          <div class="flex items-center gap-3 rounded-lg border border-red-400/[0.12] bg-red-400/[0.06] px-4 py-3">
            <Icon name="lucide:dollar-sign" class="h-[18px] w-[18px] shrink-0 text-red-400" />
            <span class="text-sm font-medium text-[#a1a1aa]">Price increase</span>
          </div>
          <div class="flex items-center gap-3 rounded-lg border border-red-400/[0.12] bg-red-400/[0.06] px-4 py-3">
            <Icon name="lucide:lock" class="h-[18px] w-[18px] shrink-0 text-red-400" />
            <span class="text-sm font-medium text-[#a1a1aa]">Feature lock-in</span>
          </div>
          <div class="flex items-center gap-3 rounded-lg border border-red-400/[0.12] bg-red-400/[0.06] px-4 py-3">
            <Icon name="lucide:file-text" class="h-[18px] w-[18px] shrink-0 text-red-400" />
            <span class="text-sm font-medium text-[#a1a1aa]">Policy change</span>
          </div>
        </div>

        <!-- Divider -->
        <div class="flex items-center justify-center py-5">
          <span class="rounded-full border border-accent/15 bg-accent/10 px-5 py-2 font-mono text-xs font-bold uppercase tracking-widest text-accent">With Readied</span>
        </div>

        <!-- Solution card -->
        <div class="flex items-center gap-4 rounded-xl border border-accent/15 bg-accent/10 p-4">
          <div class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-xl bg-accent text-white">
            <Icon name="lucide:folder" class="h-[22px] w-[22px]" />
          </div>
          <div class="flex flex-1 flex-col gap-0.5">
            <strong class="text-base text-accent">Your local folder</strong>
            <span class="text-sm text-[#71717a]">Always accessible. Always yours.</span>
          </div>
          <div class="flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-full bg-accent text-white">
            <Icon name="lucide:check" class="h-4 w-4" />
          </div>
        </div>
      </div>

      <!-- Comparison side -->
      <div class="flex flex-col gap-4">
        <!-- Comparison table -->
        <div class="overflow-hidden rounded-xl bg-surface">
          <!-- Table header -->
          <div class="grid grid-cols-2 border-b border-white/[0.06] bg-inset">
            <div class="flex items-center gap-2 px-5 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#71717a]">
              <Icon name="lucide:cloud" class="h-4 w-4 shrink-0" />
              <span>Cloud apps</span>
            </div>
            <div class="flex items-center gap-2 border-l border-white/[0.06] bg-accent/[0.06] px-5 py-4 font-mono text-xs font-bold uppercase tracking-widest text-accent">
              <Icon name="lucide:folder" class="h-4 w-4 shrink-0" />
              <span>Readied</span>
            </div>
          </div>

          <!-- Table rows -->
          <ul class="list-none">
            {comparisons.map((row, i) => (
              <li class={`grid grid-cols-2 ${i < comparisons.length - 1 ? 'border-b border-white/[0.06]' : ''}`}>
                <div class="flex items-start gap-3 px-5 py-4 text-sm leading-snug text-[#71717a]">
                  <Icon name="lucide:x-circle" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-red-400/60" />
                  <span>{row.cloud}</span>
                </div>
                <div class="flex items-start gap-3 border-l border-white/[0.06] bg-accent/[0.04] px-5 py-4 text-sm leading-snug text-[#f4f4f5]">
                  <Icon name="lucide:check-circle" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-accent" />
                  <span>{row.local}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Info note -->
        <div class="flex items-start gap-3 rounded-xl border border-accent/10 bg-accent/[0.04] px-5 py-4">
          <Icon name="lucide:info" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-accent" />
          <p class="text-sm leading-relaxed text-[#a1a1aa]">
            Even if Readied disappears tomorrow, your notes remain. They're just files on your computer.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
