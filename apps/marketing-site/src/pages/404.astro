---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
---

<Base title="Page Not Found — Readied" description="The page you're looking for doesn't exist.">
  <div class="min-h-screen flex items-center justify-center p-4 sm:p-6">
    <div class="w-full max-w-[480px]">
      <div class="text-center rounded-xl bg-surface p-8 sm:p-12">
        <div class="flex items-center justify-center mb-6 text-[#71717a]">
          <Icon name="lucide:frown" size={80} />
        </div>

        <span class="block font-mono text-6xl sm:text-[6rem] font-extrabold leading-none mb-4 text-accent">404</span>

        <h1 class="text-xl sm:text-2xl font-bold text-[#f4f4f5] mb-3">Oops, this page wandered off</h1>
        <p class="text-base text-[#a1a1aa] leading-relaxed mb-8">The page you're looking for doesn't exist or has been moved.</p>

        <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3 mb-8">
          <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm transition-colors hover:bg-accent-hover">
            <Icon name="lucide:home" size={18} />
            Go home
          </a>
          <a href="/faq" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-white/[0.08] text-[#a1a1aa] font-medium text-sm transition-colors hover:bg-white/5 hover:text-white">
            View FAQ
          </a>
        </div>

        <div class="pt-6 border-t border-white/[0.06]">
          <span class="block font-mono text-xs font-semibold uppercase tracking-[0.1em] text-[#71717a] mb-3">Or try these:</span>
          <div class="flex flex-wrap justify-center gap-2">
            <a href="/download" class="px-3 py-2 text-sm text-[#a1a1aa] border border-white/[0.08] rounded-lg transition-colors hover:text-accent hover:bg-white/5">Download</a>
            <a href="/pricing" class="px-3 py-2 text-sm text-[#a1a1aa] border border-white/[0.08] rounded-lg transition-colors hover:text-accent hover:bg-white/5">Pricing</a>
            <a href="/changelog" class="px-3 py-2 text-sm text-[#a1a1aa] border border-white/[0.08] rounded-lg transition-colors hover:text-accent hover:bg-white/5">Changelog</a>
            <a href="https://medium.com/@tomymaritano" target="_blank" rel="noopener" class="px-3 py-2 text-sm text-[#a1a1aa] border border-white/[0.08] rounded-lg transition-colors hover:text-accent hover:bg-white/5">Blog</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
