---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
---

<Base title="Page Not Found — Readied" description="The page you're looking for doesn't exist.">
  <main class="error-page">
    <div class="error-container">
      <div class="error-card glass">
        <div class="error-icon">
          <Icon name="lucide:frown" size={80} />
        </div>

        <span class="error-code">404</span>

        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-lg" data-magnetic="0.2">
            <Icon name="lucide:home" size={18} />
            Go home
          </a>
          <a href="/faq" class="btn btn-ghost btn-lg" data-magnetic="0.2">View FAQ</a>
        </div>

        <div class="error-suggestions">
          <span class="suggestions-label">Or try these:</span>
          <div class="suggestions-links">
            <a href="/download">Download</a>
            <a href="/pricing">Pricing</a>
            <a href="/changelog">Changelog</a>
            <a href="/blog">Blog</a>
          </div>
        </div>

        <div class="error-glow"></div>
      </div>
    </div>
  </main>
</Base>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .error-container {
    width: 100%;
    max-width: 480px;
  }

  .error-card {
    position: relative;
    text-align: center;
    padding: var(--space-12) var(--space-8);
    overflow: hidden;
  }

  .error-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
    color: var(--text-muted);
  }

  .error-code {
    display: block;
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      var(--accent-light) 50%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }

  .error-card h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .error-card > p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .error-actions .btn {
    gap: var(--space-2);
  }

  .error-suggestions {
    padding-top: var(--space-6);
    border-top: 1px solid var(--glass-border);
  }

  .suggestions-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .suggestions-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .suggestions-links a {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .suggestions-links a:hover {
    color: var(--accent);
    border-color: var(--glass-border-accent);
    background: var(--glass-bg-accent);
  }

  .error-glow {
    position: absolute;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .error-page {
      padding: var(--space-4);
    }

    .error-card {
      padding: var(--space-8) var(--space-5);
    }

    .error-code {
      font-size: 4rem;
    }

    .error-card h1 {
      font-size: var(--text-xl);
    }

    .error-actions {
      flex-direction: column;
    }

    .error-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
