---
// Extract token from URL query params
const token = Astro.url.searchParams.get('token');

// If no token, redirect to 404
if (!token) {
  return Astro.redirect('/404');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verifying...</title>
    <meta http-equiv="refresh" content={`0; url=readied://auth/verify?token=${token}`}>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: #0a0a0b;
        color: #f4f4f5;
        text-align: center;
        padding: 2rem;
      }

      .container {
        max-width: 500px;
        position: relative;
        z-index: 1;
      }

      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        font-weight: 600;
      }

      p {
        font-size: 1.125rem;
        margin-bottom: 1.5rem;
        color: #a1a1aa;
      }

      a {
        color: #c4b5fd;
        text-decoration: underline;
      }

      a:hover {
        color: #a78bfa;
        text-decoration: none;
      }

      .button {
        display: inline-block;
        padding: 0.75rem 2rem;
        background: #a78bfa;
        color: #fff;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        margin-top: 1rem;
        transition: background 0.2s;
      }

      .button:hover {
        background: #c4b5fd;
        color: #fff;
      }

      #download-prompt {
        margin-top: 2rem;
        padding: 2rem;
        background: #141415;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
      }

      #download-prompt h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }

      .spinner {
        display: inline-block;
        width: 40px;
        height: 40px;
        margin-bottom: 1rem;
        border: 4px solid rgba(255, 255, 255, 0.06);
        border-radius: 50%;
        border-top-color: #a78bfa;
        animation: spin 1s ease-in-out infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="spinner"></div>
      <h1>Opening Readied...</h1>
      <p>
        If the app doesn't open automatically,
        <a href={`readied://auth/verify?token=${token}`}>click here</a>
      </p>
      <p>
        Don't have Readied? <a href="/download">Download now</a>
      </p>

      <div id="download-prompt" style="display: none;">
        <h2>App didn't open?</h2>
        <p>Make sure you have Readied installed on your device.</p>
        <a href="/download" class="button">Download Readied</a>
      </div>
    </div>

    <script define:inline>
      // Fallback: Use window.location if meta refresh fails
      setTimeout(() => {
        const token = new URLSearchParams(window.location.search).get('token');
        if (token) {
          window.location.href = `readied://auth/verify?token=${token}`;
        }
      }, 100);

      // If still on page after 3 seconds, show download prompt
      setTimeout(() => {
        const prompt = document.getElementById('download-prompt');
        if (prompt) {
          prompt.style.display = 'block';
        }
      }, 3000);
    </script>
  </body>
</html>
