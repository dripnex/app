---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.tsx';
import { Icon } from 'astro-icon/components';
import { fetchLatestRelease, formatBytes } from '../lib/github';
import type { PlatformAsset } from '../lib/github';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
const release = await fetchLatestRelease();
const version = release?.version;
const isReleased = !!release;

function getAssets(platform: PlatformAsset['platform']) {
  return release?.assets.filter((a) => a.platform === platform) ?? [];
}

const macAssets = getAssets('mac');
const winAssets = getAssets('win');
const linuxAssets = getAssets('linux');

function primaryLabel(asset: PlatformAsset): string {
  if (asset.platform === 'mac') {
    return asset.arch === 'arm64' ? 'Apple Silicon' : 'Intel';
  }
  if (asset.platform === 'win') {
    return asset.format === 'exe' ? 'Windows x64' : 'Portable';
  }
  if (asset.platform === 'linux') {
    return asset.format === 'appimage' ? 'AppImage' : asset.format.toUpperCase();
  }
  return asset.name;
}
---

<Base title="Download — Readied" description={`Download Readied for macOS, Windows, or Linux. Try free for ${config.trialDays} days.`}>
  <section class="relative pt-32 sm:pt-40 pb-24 px-4 sm:px-6">
    <div class="relative max-w-5xl mx-auto z-10">
      <header class="text-center mb-16">
        <span class="section-label">Download</span>
        <h1 class="section-heading sm:text-4xl lg:text-5xl mb-3">
          Get <span class="text-accent">Readied</span>
        </h1>
        {isReleased ? (
          <>
            <p class="text-lg text-[#a1a1aa] mb-5">Try free for {config.trialDays} days. No account required.</p>
            <div class="flex items-center justify-center gap-3 flex-wrap">
              <span class="inline-flex items-center px-5 py-2 font-mono text-sm font-semibold rounded-full bg-accent/10 border border-accent/20 text-accent">v{version}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs font-medium text-emerald-400">
                <Icon name="lucide:check" size={12} />
                Free forever
              </span>
            </div>
          </>
        ) : (
          <>
            <p class="text-lg text-[#a1a1aa] mb-5">We're building something good. Leave your email to get notified.</p>
            <span class="inline-flex items-center px-5 py-2 font-mono text-sm font-semibold rounded-full bg-white/[0.05] border border-white/[0.08] text-[#a1a1aa]">Coming Soon</span>
            <div class="mt-10">
              <NewsletterForm client:idle />
            </div>
          </>
        )}
      </header>

      <div class={`grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10 ${!isReleased ? 'opacity-50 pointer-events-none' : ''}`}>
        <!-- macOS -->
        <article class="rounded-xl bg-surface p-6 sm:p-8 flex flex-col gap-6">
          <header class="flex items-center gap-5">
            <div class="w-14 h-14 flex items-center justify-center shrink-0 bg-accent/10 rounded-lg text-accent">
              <Icon name="simple-icons:apple" size={32} />
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#f4f4f5] mb-1">macOS</h2>
              <span class="text-sm text-[#71717a]">macOS 11 Big Sur or later</span>
            </div>
          </header>
          <div class="flex flex-wrap gap-3">
            {macAssets.length > 0 ? (
              macAssets.map((asset, i) => (
                <a href={asset.downloadUrl} class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${i === 0 ? 'bg-accent text-white hover:bg-accent-hover' : 'border border-white/[0.08] text-[#a1a1aa] hover:bg-white/5'}`}>
                  {i === 0 && <Icon name="lucide:download" size={16} />}
                  {primaryLabel(asset)}
                  <span class="text-xs opacity-70">({formatBytes(asset.size)})</span>
                </a>
              ))
            ) : (
              <>
                <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium bg-accent/50 text-white/50 cursor-not-allowed">
                  <Icon name="lucide:download" size={16} />
                  Apple Silicon
                </span>
                <span class="inline-flex items-center px-4 py-2.5 rounded-lg text-sm font-medium border border-white/[0.08] text-[#71717a] cursor-not-allowed">Intel</span>
              </>
            )}
          </div>
          <div class="rounded-lg bg-inset border border-white/[0.06] p-4 font-mono text-xs text-[#a1a1aa] overflow-x-auto">
            <p class="text-[#71717a] mb-2"># Install from DMG</p>
            <p>hdiutil attach Readied-*.dmg</p>
            <p>cp -R /Volumes/Readied/Readied.app /Applications/</p>
            <p>hdiutil detach /Volumes/Readied</p>
          </div>
        </article>

        <!-- Windows -->
        <article class="rounded-xl bg-surface p-6 sm:p-8 flex flex-col gap-6">
          <header class="flex items-center gap-5">
            <div class="w-14 h-14 flex items-center justify-center shrink-0 bg-accent/10 rounded-lg text-accent">
              <Icon name="simple-icons:windows" size={32} />
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#f4f4f5] mb-1">Windows</h2>
              <span class="text-sm text-[#71717a]">Windows 10 (64-bit) or later</span>
            </div>
          </header>
          <div class="flex flex-wrap gap-3">
            {winAssets.length > 0 ? (
              winAssets.map((asset, i) => (
                <a href={asset.downloadUrl} class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${i === 0 ? 'bg-accent text-white hover:bg-accent-hover' : 'border border-white/[0.08] text-[#a1a1aa] hover:bg-white/5'}`}>
                  {i === 0 && <Icon name="lucide:download" size={16} />}
                  {primaryLabel(asset)}
                  <span class="text-xs opacity-70">({formatBytes(asset.size)})</span>
                </a>
              ))
            ) : (
              <>
                <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium bg-accent/50 text-white/50 cursor-not-allowed">
                  <Icon name="lucide:download" size={16} />
                  Windows x64
                </span>
                <span class="inline-flex items-center px-4 py-2.5 rounded-lg text-sm font-medium border border-white/[0.08] text-[#71717a] cursor-not-allowed">Portable</span>
              </>
            )}
          </div>
          <div class="rounded-lg bg-inset border border-white/[0.06] p-4 font-mono text-xs text-[#a1a1aa] overflow-x-auto">
            <p class="text-[#71717a] mb-2"># Run the installer</p>
            <p>Readied-Setup-*.exe /S</p>
          </div>
        </article>

        <!-- Linux -->
        <article class="rounded-xl bg-surface p-6 sm:p-8 flex flex-col gap-6">
          <header class="flex items-center gap-5">
            <div class="w-14 h-14 flex items-center justify-center shrink-0 bg-accent/10 rounded-lg text-accent">
              <Icon name="simple-icons:linux" size={32} />
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#f4f4f5] mb-1">Linux</h2>
              <span class="text-sm text-[#71717a]">Ubuntu 20.04+ / Fedora 36+</span>
            </div>
          </header>
          <div class="flex flex-wrap gap-3">
            {linuxAssets.length > 0 ? (
              linuxAssets.map((asset, i) => (
                <a href={asset.downloadUrl} class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${i === 0 ? 'bg-accent text-white hover:bg-accent-hover' : 'border border-white/[0.08] text-[#a1a1aa] hover:bg-white/5'}`}>
                  {i === 0 && <Icon name="lucide:download" size={16} />}
                  {primaryLabel(asset)}
                  <span class="text-xs opacity-70">({formatBytes(asset.size)})</span>
                </a>
              ))
            ) : (
              <>
                <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium bg-accent/50 text-white/50 cursor-not-allowed">
                  <Icon name="lucide:download" size={16} />
                  AppImage
                </span>
                <span class="inline-flex items-center px-4 py-2.5 rounded-lg text-sm font-medium border border-white/[0.08] text-[#71717a] cursor-not-allowed">.deb</span>
              </>
            )}
          </div>
          <div class="rounded-lg bg-inset border border-white/[0.06] p-4 font-mono text-xs text-[#a1a1aa] overflow-x-auto">
            <p class="text-[#71717a] mb-2"># Make executable and run</p>
            <p>chmod +x Readied.AppImage && ./Readied.AppImage</p>
          </div>
        </article>
      </div>

      <!-- System Requirements -->
      <section class="glass-card p-6 sm:p-8 mb-10">
        <h3 class="text-lg font-semibold text-[#f4f4f5] mb-6 flex items-center gap-3">
          <Icon name="lucide:cpu" size={20} class="text-accent" />
          System requirements
        </h3>
        <dl class="flex flex-col">
          <div class="flex justify-between items-center py-4 border-b border-white/[0.06]">
            <dt class="text-sm text-[#71717a] font-medium">RAM</dt>
            <dd class="text-sm text-[#a1a1aa] font-medium">4 GB minimum</dd>
          </div>
          <div class="flex justify-between items-center py-4 border-b border-white/[0.06]">
            <dt class="text-sm text-[#71717a] font-medium">Disk</dt>
            <dd class="text-sm text-[#a1a1aa] font-medium">200 MB</dd>
          </div>
          <div class="flex justify-between items-center py-4">
            <dt class="text-sm text-[#71717a] font-medium">Display</dt>
            <dd class="text-sm text-[#a1a1aa] font-medium">1280x720 minimum</dd>
          </div>
        </dl>
      </section>

      <!-- Verification -->
      <section class="py-6">
        <h3 class="text-lg font-semibold text-[#f4f4f5] mb-3">Verification</h3>
        <p class="text-base text-[#a1a1aa] leading-relaxed">
          Each release includes SHA256 checksums. Source available on
          <a href="https://github.com/tomymaritano/readide" target="_blank" rel="noopener" class="text-accent underline underline-offset-2 inline-flex items-center gap-1 transition-colors hover:text-accent-hover hover:no-underline">
            GitHub
            <Icon name="lucide:external-link" size={14} />
          </a>.
        </p>
      </section>
    </div>
  </section>
  <Footer />
</Base>
