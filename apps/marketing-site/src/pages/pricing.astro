---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
const { plans, guarantees, trialDays, trialDescription } = config;
const proPricing = plans.pro.pricing!;

const faqs = [
  { q: 'What if you stop developing Readied?', a: guarantees.freeTierForever.description },
  { q: 'Can I cancel my Pro subscription?', a: guarantees.cancelAnytime.description },
  { q: 'Can I export my data?', a: guarantees.noLockIn.description },
  { q: 'What about refunds?', a: guarantees.refund.description }
];
---

<Base title="Pricing — Readied" description="Free forever. Pro when you need it.">
  <section class="relative pt-32 sm:pt-40 pb-24 px-4 sm:px-6">
    <div class="relative z-10 max-w-5xl mx-auto">
      <!-- Page header -->
      <header class="text-center mb-16">
        <span class="section-label">Pricing</span>
        <h1 class="section-heading text-4xl lg:text-5xl">
          Free forever.<br />
          <span class="text-accent">Pro when you need it.</span>
        </h1>
        <p class="text-lg text-[#a1a1aa] max-w-[540px] mx-auto">
          Start with the free tier -- it does a lot. Upgrade to Pro when you want
          sync, graph view, and all the extras.
        </p>
      </header>

      <!-- Pricing cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-10">
        <!-- Free Tier -->
        <div class="glass-card p-6 sm:p-8">
          <div class="pb-6 border-b border-white/[0.06] mb-4">
            <div class="w-11 h-11 flex items-center justify-center rounded-lg bg-accent/10 text-accent mb-4">
              <Icon name="lucide:heart" size={22} />
            </div>
            <div class="text-lg font-semibold text-[#f4f4f5] mb-2">{plans.free.name}</div>
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-3xl sm:text-4xl font-bold text-[#f4f4f5]">Free</span>
              <span class="text-base text-[#71717a]">forever</span>
            </div>
          </div>

          <p class="text-sm text-[#a1a1aa] mb-6">{plans.free.description}</p>

          <ul class="list-none mb-6 space-y-0">
            {plans.free.features.map((f) => (
              <li class="flex items-center gap-3 py-2 text-sm text-[#a1a1aa]">
                <span class="flex items-center justify-center shrink-0 w-[22px] h-[22px] rounded-full bg-white/[0.05] text-[#71717a]">
                  <Icon name="lucide:check" size={14} />
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a href="/download" class="flex items-center justify-center gap-3 w-full px-6 py-3 rounded-lg border border-white/[0.08] text-[#a1a1aa] font-medium text-sm transition-colors hover:bg-white/5 hover:text-white">
            <Icon name="lucide:download" size={20} />
            Download Free
          </a>
        </div>

        <!-- Pro Tier -->
        <div class="relative glass-card-glow p-6 sm:p-8 overflow-hidden">
          <span class="absolute top-5 right-5 font-mono text-xs font-bold uppercase tracking-wider text-white bg-accent px-3 py-1 rounded-full">Most popular</span>

          <div class="pb-6 border-b border-white/[0.06] mb-4">
            <div class="w-11 h-11 flex items-center justify-center rounded-lg bg-accent/10 text-accent mb-4">
              <Icon name="lucide:zap" size={22} />
            </div>
            <div class="text-lg font-semibold text-[#f4f4f5] mb-2">{plans.pro.name}</div>
            <div class="flex items-baseline gap-3 flex-wrap">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-3xl sm:text-4xl font-bold text-accent">{proPricing.intervals.monthly.label}</span>
              </div>
              <span class="text-sm text-[#71717a]">or</span>
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-3xl sm:text-4xl font-bold text-accent">{proPricing.intervals.annual.label}</span>
                <span class="font-mono text-xs font-semibold text-accent bg-accent/10 px-3 py-1 rounded-full">Save {proPricing.annualSavings}</span>
              </div>
            </div>
          </div>

          <p class="text-sm text-[#a1a1aa] mb-6">{plans.pro.description}</p>

          <ul class="list-none mb-6 space-y-0">
            {plans.pro.features.map((f) => (
              <li class="flex items-center gap-3 py-2 text-sm text-[#a1a1aa]">
                <span class="flex items-center justify-center shrink-0 w-[22px] h-[22px] rounded-full bg-accent/10 text-accent">
                  <Icon name="lucide:check" size={14} />
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3 px-4 py-3 mb-6 rounded-lg bg-accent/[0.06] border border-accent/10 text-sm text-[#a1a1aa]">
            <Icon name="lucide:sparkles" size={16} class="text-accent" />
            <span>{trialDescription}</span>
          </div>

          <a href="/download" class="flex items-center justify-center gap-3 w-full px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm transition-colors hover:bg-accent-hover">
            <Icon name="lucide:zap" size={20} />
            Start {trialDays}-day free trial
          </a>
        </div>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 mb-20 py-6">
        <div class="flex items-center gap-2 text-sm text-[#71717a]">
          <Icon name="lucide:shield-check" size={18} class="text-accent" />
          <span>No credit card required</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-[#71717a]">
          <Icon name="lucide:lock" size={18} class="text-accent" />
          <span>Your data stays local</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-[#71717a]">
          <Icon name="lucide:refresh-cw" size={18} class="text-accent" />
          <span>Cancel anytime</span>
        </div>
      </div>

      <!-- FAQ section -->
      <section class="max-w-[640px] mx-auto">
        <div class="text-center mb-8">
          <span class="section-label">FAQ</span>
          <h2 class="section-heading">Questions? We've got answers.</h2>
        </div>
        <div class="flex flex-col gap-3 mb-6">
          {faqs.map(faq => (
            <details class="glass-card overflow-hidden group">
              <summary class="flex items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-[#f4f4f5] cursor-pointer list-none [&::-webkit-details-marker]:hidden transition-colors hover:text-accent">
                <span class="flex-1">{faq.q}</span>
                <Icon name="lucide:chevron-down" size={20} class="shrink-0 text-[#71717a] transition-transform duration-200 group-open:rotate-180 group-open:text-accent" />
              </summary>
              <p class="px-5 py-4 text-sm text-[#a1a1aa] leading-relaxed border-t border-white/[0.06] m-0">{faq.a}</p>
            </details>
          ))}
        </div>
        <a href="/faq" class="group flex justify-center items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-hover">
          View all FAQs
          <Icon name="lucide:arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
        </a>
      </section>
    </div>
  </section>

  <Footer />
</Base>
