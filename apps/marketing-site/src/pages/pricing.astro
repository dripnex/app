---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { PRICING, PLANS, GUARANTEES } from '@readied/product-config';

const faqs = [
  { q: 'What if you stop developing Readied?', a: GUARANTEES.freeTierForever.description },
  { q: 'Can I cancel my Pro subscription?', a: GUARANTEES.cancelAnytime.description },
  { q: 'Can I export my data?', a: GUARANTEES.noLockIn.description },
  { q: 'What about refunds?', a: GUARANTEES.refund.description }
];
---

<Base title="Pricing — Readied" description="Free forever. Pro when you need it.">
  <main class="pricing-page">
    <div class="container">
      <header class="page-header">
        <span class="label">Pricing</span>
        <h1>Free forever.<br/><span class="text-gradient">Pro when you need it.</span></h1>
        <p class="page-intro">Start with the free tier. Upgrade to Pro for sync and advanced features.</p>
      </header>

      <div class="pricing-layout">
        <!-- Free Tier -->
        <div class="pricing-card glass">
          <div class="card-header">
            <div class="plan-name">{PLANS.free.name}</div>
            <div class="price">
              <span class="amount">{PRICING.free.label}</span>
              <span class="period">forever</span>
            </div>
          </div>

          <p class="plan-description">{PLANS.free.description}</p>

          <ul class="features">
            {PLANS.free.features.map((f) => (
              <li>
                <Icon name="lucide:check" size={16} class="icon-check" />
                {f}
              </li>
            ))}
          </ul>

          <a href="/download" class="btn btn-ghost btn-lg" data-magnetic="0.2">
            <Icon name="lucide:download" size={20} />
            Download Free
          </a>
        </div>

        <!-- Pro Tier -->
        <div class="pricing-card pricing-card-pro glass">
          <div class="card-header">
            <div class="plan-name">{PLANS.pro.name}</div>
            <div class="price-options">
              <div class="price">
                <span class="amount">{PRICING.pro.monthly.label}</span>
              </div>
              <span class="price-or">or</span>
              <div class="price">
                <span class="amount">{PRICING.pro.annual.label}</span>
                <span class="savings">Save {PRICING.pro.annual.savings}</span>
              </div>
            </div>
          </div>

          <p class="plan-description">{PLANS.pro.description}</p>

          <ul class="features">
            {PLANS.pro.features.map((f) => (
              <li>
                <Icon name="lucide:check" size={16} class="icon-accent" />
                {f}
              </li>
            ))}
          </ul>

          <div class="trial-info glass">
            <Icon name="lucide:sparkles" size={16} class="icon-accent" />
            <span>{PRICING.trial.description}</span>
          </div>

          <a href="/download" class="btn btn-primary btn-lg" data-magnetic="0.2">
            <Icon name="lucide:zap" size={20} />
            Start {PRICING.trial.days}-day free trial
          </a>

          <div class="card-glow"></div>
        </div>
      </div>

      <section class="faq">
        <h2>Questions</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item glass">
              <summary class="faq-question">
                <span>{faq.q}</span>
                <Icon name="lucide:chevron-down" size={20} class="chevron" />
              </summary>
              <p class="faq-answer">{faq.a}</p>
            </details>
          ))}
        </div>
        <a href="/faq" class="faq-more-link">
          View all FAQs
          <Icon name="lucide:arrow-right" size={14} />
        </a>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .pricing-page {
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-6) var(--space-24);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .page-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .page-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .pricing-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
    margin-bottom: var(--space-16);
  }

  .pricing-card {
    position: relative;
    padding: var(--space-8);
    overflow: hidden;
  }

  .pricing-card-pro {
    border-color: var(--accent);
  }

  .card-header {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: var(--space-4);
  }

  .plan-name {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .price-options {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .price-or {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .amount {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--text-primary);
  }

  .pricing-card-pro .amount {
    color: var(--accent);
  }

  .period {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .savings {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-glow);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .plan-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .features {
    list-style: none;
    margin-bottom: var(--space-6);
  }

  .features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .icon-check {
    color: var(--text-muted);
  }

  .trial-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .pricing-card .btn {
    width: 100%;
    justify-content: center;
    gap: var(--space-3);
  }

  .card-glow {
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
  }

  .faq {
    max-width: 600px;
    margin: 0 auto;
  }

  .faq h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .faq-item {
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question span {
    flex: 1;
  }

  .chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .faq-item[open] .chevron {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-question {
    border-bottom: 1px solid var(--glass-border);
  }

  .faq-answer {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    background: var(--glass-bg-dark);
    margin: 0;
  }

  .faq-more-link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    transition: gap var(--duration-fast) var(--ease-out);
  }

  .faq-more-link:hover {
    gap: var(--space-3);
  }

  @media (max-width: 768px) {
    .pricing-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .pricing-page {
      padding: calc(var(--nav-height) + var(--space-10)) var(--space-4) var(--space-16);
    }

    .page-header h1 {
      font-size: var(--text-2xl);
    }

    .pricing-card {
      padding: var(--space-6);
    }

    .price-options {
      flex-direction: column;
      gap: var(--space-1);
    }

    .price-or {
      display: none;
    }
  }
</style>
