---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import SubscribeFlow from '../components/SubscribeFlow.tsx';
import { getProductConfig } from '@readied/product-config';

const config = getProductConfig();
---

<Base title="Get Readied Pro" description="Start your free trial of Readied Pro with cloud sync, backlinks, and advanced features.">
  <section class="pt-32 sm:pt-40 pb-24 px-4 sm:px-6 min-h-screen">
    <div class="max-w-5xl mx-auto">
      <SubscribeFlow
        client:idle
        trialDays={config.trialDays}
        plans={JSON.parse(JSON.stringify(config.plans))}
        guarantees={JSON.parse(JSON.stringify(config.guarantees))}
      />
    </div>
  </section>
  <Footer />
</Base>
