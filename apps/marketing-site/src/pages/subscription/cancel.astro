---
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
---

<Base title="Checkout Canceled" description="Your checkout was canceled. You can still use Readied for free.">
  <section class="min-h-screen pt-24 sm:pt-32 pb-16 px-4 sm:px-6 text-center">
    <div class="max-w-4xl mx-auto">
      <!-- Cancel icon -->
      <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-surface flex items-center justify-center text-[#71717a]">
        <Icon name="lucide:undo-2" size={36} />
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f4f4f5] mb-4">Checkout Canceled</h1>
      <p class="text-lg sm:text-xl text-[#a1a1aa] mb-12">No worries! You can still use Readied for free</p>

      <!-- Option cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 my-12">
        <!-- Free option -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface text-left">
          <h3 class="text-xl sm:text-2xl font-bold text-[#f4f4f5] mb-4">Try Readied Free</h3>
          <p class="text-[#a1a1aa] mb-6">Get started with unlimited local notes, full markdown editor, and 100% offline functionality.</p>
          <a href="/download" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/[0.08] text-[#a1a1aa] font-medium text-sm transition-colors hover:bg-white/5 hover:text-white">
            <Icon name="lucide:download" size={18} />
            Download Free
          </a>
        </div>

        <!-- Pro option -->
        <div class="p-6 sm:p-8 rounded-xl bg-surface border border-accent/20 text-left">
          <h3 class="text-xl sm:text-2xl font-bold text-[#f4f4f5] mb-4">Changed your mind?</h3>
          <p class="text-[#a1a1aa] mb-6">Pro includes cloud sync, backlinks, graph view, and advanced search. Start with a 14-day free trial.</p>
          <a href="/subscribe" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm transition-colors hover:bg-accent-hover">
            <Icon name="lucide:zap" size={18} />
            Try Pro
          </a>
        </div>
      </div>

      <!-- Why upgrade -->
      <div class="my-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#f4f4f5] mb-8">Why upgrade to Pro?</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
          <div class="text-center p-4 sm:p-6 rounded-xl bg-surface">
            <div class="flex items-center justify-center mb-4">
              <Icon name="lucide:cloud" size={32} class="text-accent" />
            </div>
            <h4 class="text-base sm:text-lg font-semibold text-[#f4f4f5] mb-2">Cloud Sync</h4>
            <p class="text-sm text-[#a1a1aa]">Access your notes from any device with automatic sync</p>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-xl bg-surface">
            <div class="flex items-center justify-center mb-4">
              <Icon name="lucide:link" size={32} class="text-accent" />
            </div>
            <h4 class="text-base sm:text-lg font-semibold text-[#f4f4f5] mb-2">Backlinks</h4>
            <p class="text-sm text-[#a1a1aa]">See connections between your notes automatically</p>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-xl bg-surface">
            <div class="flex items-center justify-center mb-4">
              <Icon name="lucide:search" size={32} class="text-accent" />
            </div>
            <h4 class="text-base sm:text-lg font-semibold text-[#f4f4f5] mb-2">Advanced Search</h4>
            <p class="text-sm text-[#a1a1aa]">Find anything instantly with powerful search</p>
          </div>
          <div class="text-center p-4 sm:p-6 rounded-xl bg-surface">
            <div class="flex items-center justify-center mb-4">
              <Icon name="lucide:git-branch" size={32} class="text-accent" />
            </div>
            <h4 class="text-base sm:text-lg font-semibold text-[#f4f4f5] mb-2">Graph View</h4>
            <p class="text-sm text-[#a1a1aa]">Visualize relationships in your knowledge base</p>
          </div>
        </div>
      </div>

      <p class="mt-16 text-[#a1a1aa]">
        Questions? <a href="mailto:support@readied.app" class="text-accent hover:underline">Contact support</a> or check out our <a href="/faq" class="text-accent hover:underline">FAQ</a>
      </p>
    </div>
  </section>
</Base>
