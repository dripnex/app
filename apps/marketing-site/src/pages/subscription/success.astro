---
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
---

<Base title="Welcome to Readied Pro!" description="Your subscription is active. Download the app to get started.">
  <section class="min-h-screen pt-24 sm:pt-32 pb-16 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <!-- Success icon -->
      <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-accent/10 flex items-center justify-center">
        <Icon name="lucide:check" size={40} class="text-accent" />
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 text-accent">Welcome to Readied Pro!</h1>
      <p class="text-lg sm:text-xl text-[#a1a1aa] mb-12">Your subscription is now active</p>

      <!-- Next steps -->
      <div class="my-12 text-left">
        <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5] text-center mb-8">What's next?</h2>
        <ol class="list-none flex flex-col gap-4 sm:gap-6">
          <li class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 p-6 rounded-xl bg-surface text-center sm:text-left">
            <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-accent text-white font-mono font-bold">1</span>
            <div>
              <strong class="block text-lg text-[#f4f4f5] mb-1">Download Readied</strong>
              <p class="text-[#a1a1aa] m-0">Get the app for your platform</p>
            </div>
          </li>
          <li class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 p-6 rounded-xl bg-surface text-center sm:text-left">
            <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-accent text-white font-mono font-bold">2</span>
            <div>
              <strong class="block text-lg text-[#f4f4f5] mb-1">Sign in with your email</strong>
              <p class="text-[#a1a1aa] m-0">Use the same email you just subscribed with</p>
            </div>
          </li>
          <li class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 p-6 rounded-xl bg-surface text-center sm:text-left">
            <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-accent text-white font-mono font-bold">3</span>
            <div>
              <strong class="block text-lg text-[#f4f4f5] mb-1">Start taking notes</strong>
              <p class="text-[#a1a1aa] m-0">All Pro features are unlocked and ready to use</p>
            </div>
          </li>
        </ol>
      </div>

      <!-- Download CTA -->
      <div class="my-12">
        <a href="/download" class="inline-flex items-center gap-2 px-8 sm:px-10 py-4 sm:py-5 text-base sm:text-lg font-semibold rounded-lg bg-accent text-white transition-colors hover:bg-accent-hover">
          <Icon name="lucide:download" size={20} />
          Download Readied
        </a>
      </div>

      <!-- Pro features info -->
      <div class="my-12 rounded-xl bg-accent/[0.06] border border-accent/20 p-6 sm:p-8 text-left">
        <h3 class="text-lg sm:text-xl font-bold text-[#f4f4f5] text-center mb-6">What's included in Pro</h3>
        <ul class="list-none grid grid-cols-1 sm:grid-cols-2 gap-3">
          <li class="flex items-center gap-2 text-[#a1a1aa] py-2">
            <Icon name="lucide:check" size={16} class="text-accent shrink-0" />
            Cloud sync across all your devices
          </li>
          <li class="flex items-center gap-2 text-[#a1a1aa] py-2">
            <Icon name="lucide:check" size={16} class="text-accent shrink-0" />
            Backlinks and graph view
          </li>
          <li class="flex items-center gap-2 text-[#a1a1aa] py-2">
            <Icon name="lucide:check" size={16} class="text-accent shrink-0" />
            Advanced search capabilities
          </li>
          <li class="flex items-center gap-2 text-[#a1a1aa] py-2">
            <Icon name="lucide:check" size={16} class="text-accent shrink-0" />
            Priority support
          </li>
          <li class="flex items-center gap-2 text-[#a1a1aa] py-2">
            <Icon name="lucide:check" size={16} class="text-accent shrink-0" />
            Early access to new features
          </li>
        </ul>
      </div>

      <p class="mt-12 text-[#a1a1aa]">
        Need help? <a href="mailto:support@readied.app" class="text-accent hover:underline">Contact support</a>
      </p>
    </div>
  </section>
</Base>
