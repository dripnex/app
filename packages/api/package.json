{
  "name": "@dripnex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:staging": "node scripts/embed-migrations.mjs && wrangler deploy --env staging",
    "deploy:production": "node scripts/embed-migrations.mjs && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:embed": "node scripts/embed-migrations.mjs",
    "db:migrate": "node --experimental-strip-types src/db/migrate.cli.ts",
    "db:studio": "drizzle-kit studio",
    "tail": "wrangler tail",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "wrangler": "wrangler",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:preview": "email dev --dir src/emails --port 3333"
  },
  "dependencies": {
    "@dripnex/product-config": "workspace:^",
    "@dripnex/sync-core": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@react-email/ui": "^6.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "react-email": "^6.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.126.0"
  }
}
