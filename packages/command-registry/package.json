{
  "name": "@readied/command-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Command registry and keybinding system for Readied",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./definitions": {
      "types": "./src/definitions/index.ts",
      "import": "./src/definitions/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
