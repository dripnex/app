    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
