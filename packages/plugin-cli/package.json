{
  "name": "@dripnex/plugin-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tool for scaffolding Dripnex plugins",
  "type": "module",
  "bin": {
    "dripnex-plugin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dripnex/storage-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
