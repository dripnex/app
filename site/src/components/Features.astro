---
import { Icon } from 'astro-icon/components';

const features = [
  {
    id: 'editor',
    title: 'Markdown editor',
    description: 'Syntax highlighting, live preview, and keyboard shortcuts. Write without friction.',
    screenshot: '/screenshots/editor.png',
    icon: 'lucide:square-pen'
  },
  {
    id: 'files',
    title: 'Your files, your structure',
    description: 'Work with real files and folders on your disk. No proprietary database, no hidden formats.',
    screenshot: '/screenshots/files.png',
    icon: 'lucide:folder'
  },
  {
    id: 'backlinks',
    title: 'Backlinks & search',
    description: 'Find connections between notes instantly. Full-text search across everything.',
    screenshot: '/screenshots/backlinks.png',
    icon: 'lucide:search'
  },
  {
    id: 'export',
    title: 'Export to anything',
    description: 'PDF, HTML, or plain Markdown. Your notes are portable by design.',
    screenshot: '/screenshots/export.png',
    icon: 'lucide:upload'
  }
];
---

<section class="features">
  <div class="container">
    <header class="section-header" data-reveal="fade-up">
      <span class="label">Features</span>
      <h2>Everything you need.<br/><span class="text-gradient">Nothing you don't.</span></h2>
    </header>

    <div class="features-grid" data-stagger="150">
      {features.map((feature, i) => (
        <article class="feature-card glass">
          <div class="card-icon">
            <Icon name={feature.icon} size={24} />
          </div>
          <div class="card-content">
            <span class="card-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
          <div class="card-preview">
            <img
              src={feature.screenshot}
              alt={feature.title}
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="preview-placeholder">
              <span>Preview</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    position: relative;
    padding: var(--space-24) 0;
    background: transparent;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .section-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .section-header h2 {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    overflow: hidden;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg-accent);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--radius-md);
    color: var(--accent);
    margin-bottom: var(--space-6);
  }

  .card-content {
    margin-bottom: var(--space-6);
  }

  .card-number {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }

  .card-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .card-content p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card-preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--glass-bg-dark);
    border: 1px solid var(--glass-border);
  }

  .card-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-placeholder {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .card-preview img[style*="display: none"] + .preview-placeholder {
    display: flex;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .features {
      padding: var(--space-16) 0;
    }

    .section-header h2 {
      font-size: var(--text-2xl);
    }

    .feature-card {
      padding: var(--space-6);
    }
  }
</style>
