---
import { Icon } from 'astro-icon/components';

const comparisons = [
  {
    cloud: 'Files stored on someone else\'s server',
    local: 'Files on your disk, in folders you control'
  },
  {
    cloud: 'Requires internet to access your notes',
    local: 'Works offline, always'
  },
  {
    cloud: 'Proprietary format, export "when available"',
    local: 'Standard Markdown, open with any editor'
  },
  {
    cloud: 'Company pivots, your data migrates',
    local: 'Your files stay exactly where they are'
  }
];
---

<section class="why-local">
  <div class="why-local-container">
    <header class="why-header" data-reveal="fade-up">
      <span class="label">Why local-first</span>
      <h2>Your notes shouldn't<br/><span class="text-gradient">depend on us</span></h2>
      <p class="lead">
        Cloud apps come and go. Business models change. Servers shut down.
        But a folder of Markdown files? That works forever.
      </p>
    </header>

    <div class="why-content">
      <!-- Risks card -->
      <div class="risks-card glass" data-reveal="fade-right" data-reveal-delay="100">
        <div class="risks-header">
          <span class="risks-title">With cloud apps, you're vulnerable to:</span>
        </div>
        <div class="risks-grid">
          <div class="risk-item">
            <Icon name="lucide:server" size={18} />
            <span>Server shutdown</span>
          </div>
          <div class="risk-item">
            <Icon name="lucide:dollar-sign" size={18} />
            <span>Price increase</span>
          </div>
          <div class="risk-item">
            <Icon name="lucide:lock" size={18} />
            <span>Feature lock-in</span>
          </div>
          <div class="risk-item">
            <Icon name="lucide:file-text" size={18} />
            <span>Policy change</span>
          </div>
        </div>

        <div class="solution-divider">
          <span>With Readied</span>
        </div>

        <div class="solution-card">
          <div class="solution-icon">
            <Icon name="lucide:folder" size={22} />
          </div>
          <div class="solution-text">
            <strong>Your local folder</strong>
            <span>Always accessible. Always yours.</span>
          </div>
          <div class="solution-check">
            <Icon name="lucide:check" size={16} />
          </div>
        </div>
      </div>

      <!-- Comparison side: table + note -->
      <div class="comparison-side" data-reveal="fade-left" data-reveal-delay="200">
        <div class="comparison-table glass">
          <div class="table-header">
            <div class="col-header col-cloud">
              <Icon name="lucide:cloud" size={16} />
              <span>Cloud apps</span>
            </div>
            <div class="col-header col-local">
              <Icon name="lucide:folder" size={16} />
              <span>Readied</span>
            </div>
          </div>
          <ul class="table-rows">
            {comparisons.map((row) => (
              <li class="table-row">
                <div class="cell cell-cloud">
                  <Icon name="lucide:x-circle" size={18} />
                  <span>{row.cloud}</span>
                </div>
                <div class="cell cell-local">
                  <Icon name="lucide:check-circle" size={18} />
                  <span>{row.local}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="why-note glass">
          <Icon name="lucide:info" size={18} />
          <p>Even if Readied disappears tomorrow, your notes remain. They're just files on your computer.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-local {
    padding: var(--space-24) var(--space-6);
  }

  .why-local-container {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .why-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-12);
  }

  .why-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .why-header h2 {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .lead {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .why-content {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-6);
    align-items: start;
  }

  .comparison-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Risks card */
  .risks-card {
    padding: var(--space-6);
  }

  .risks-header {
    margin-bottom: var(--space-4);
  }

  .risks-title {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .risks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .risk-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.15);
    border-radius: var(--radius-md);
  }

  .risk-item svg {
    flex-shrink: 0;
    color: #ef4444;
  }

  .risk-item span {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .solution-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5) 0;
  }

  .solution-divider span {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: var(--space-2) var(--space-4);
    background: var(--glass-bg-accent);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--radius-full);
  }

  .solution-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--glass-bg-accent);
    border: 1px solid var(--glass-border-accent);
    border-radius: var(--radius-lg);
  }

  .solution-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    border-radius: var(--radius-md);
    color: var(--bg-base);
  }

  .solution-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .solution-text strong {
    font-size: var(--text-base);
    color: var(--accent);
  }

  .solution-text span {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .solution-check {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    border-radius: var(--radius-full);
    color: var(--bg-base);
  }

  /* Comparison table */
  .comparison-table {
    overflow: hidden;
  }

  .table-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--glass-bg-dark);
    border-bottom: 1px solid var(--glass-border);
  }

  .col-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .col-header svg {
    flex-shrink: 0;
  }

  .col-local {
    color: var(--accent);
    border-left: 1px solid var(--glass-border);
    background: var(--glass-bg-accent);
  }

  .table-rows {
    list-style: none;
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--glass-border);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .cell {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .cell svg {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .cell-cloud {
    color: var(--text-muted);
  }

  .cell-cloud svg {
    color: rgba(239, 68, 68, 0.5);
  }

  .cell-local {
    color: var(--text-primary);
    border-left: 1px solid var(--glass-border);
    background: var(--glass-bg-accent);
  }

  .cell-local svg {
    color: var(--accent);
  }

  .why-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
  }

  .why-note svg {
    flex-shrink: 0;
    color: var(--accent);
    margin-top: 2px;
  }

  .why-note p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .why-content {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .why-header {
      text-align: left;
    }

    .comparison-side {
      gap: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .why-local {
      padding: var(--space-16) var(--space-4);
    }

    .why-header h2 {
      font-size: var(--text-2xl);
    }

    .risks-grid {
      grid-template-columns: 1fr;
    }

    .cell {
      padding: var(--space-3) var(--space-4);
    }

    .col-header {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
