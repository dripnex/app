---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import fs from 'node:fs';
import path from 'node:path';

// Parse CHANGELOG.md (Keep a Changelog format)
const changelogPath = path.join(process.cwd(), 'CHANGELOG.md');
const changelogContent = fs.readFileSync(changelogPath, 'utf-8');

interface Change {
  type: string;
  text: string;
}

interface Release {
  version: string;
  date: string;
  current: boolean;
  changes: Change[];
}

function parseChangelog(content: string): Release[] {
  const releases: Release[] = [];
  const lines = content.split('\n');

  let currentRelease: Release | null = null;
  let currentType: string | null = null;

  for (const line of lines) {
    // Match version header: ## [1.0.0] - 2025-01
    const versionMatch = line.match(/^## \[([^\]]+)\] - (.+)$/);
    if (versionMatch) {
      if (currentRelease) {
        releases.push(currentRelease);
      }
      currentRelease = {
        version: versionMatch[1],
        date: versionMatch[2],
        current: releases.length === 0,
        changes: []
      };
      currentType = null;
      continue;
    }

    // Match change type: ### Added, ### Fixed, ### Changed
    const typeMatch = line.match(/^### (\w+)$/);
    if (typeMatch && currentRelease) {
      currentType = typeMatch[1].toLowerCase();
      continue;
    }

    // Match change item: - Some change
    const itemMatch = line.match(/^- (.+)$/);
    if (itemMatch && currentRelease && currentType) {
      currentRelease.changes.push({
        type: currentType,
        text: itemMatch[1]
      });
    }
  }

  if (currentRelease) {
    releases.push(currentRelease);
  }

  return releases;
}

const releases = parseChangelog(changelogContent);
---

<Base title="Changelog — Readied" description="Release notes.">
  <main class="changelog-page">
    <div class="container">
      <header class="page-header">
        <span class="label">Changelog</span>
        <h1>Release <span class="text-gradient">history</span></h1>
      </header>

      <div class="releases">
        {releases.map(release => (
          <article class="release glass">
            <header class="release-header">
              <div class="release-info">
                <span class="version">{release.version}</span>
                {release.current && <span class="badge glass-accent">current</span>}
              </div>
              <span class="date">{release.date}</span>
            </header>
            <ul class="changes">
              {release.changes.map(change => (
                <li>
                  <span class={`type type-${change.type}`}>{change.type}</span>
                  <span class="text">{change.text}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      {releases.length === 0 && (
        <div class="empty-state glass">
          <Icon name="lucide:clock" size={48} class="text-muted" />
          <p>No releases yet. Check back soon!</p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Base>

<style>
  .changelog-page {
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-6) var(--space-24);
  }

  .container {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    line-height: 1.15;
  }

  .releases {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .release {
    overflow: hidden;
  }

  .release-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5);
    background: var(--glass-bg-dark);
    border-bottom: 1px solid var(--glass-border);
  }

  .release-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .version {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .badge {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    border-radius: var(--radius-full);
  }

  .date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .changes {
    list-style: none;
  }

  .changes li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--glass-border);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .changes li:last-child {
    border-bottom: none;
  }

  .changes li:hover {
    background: var(--glass-bg-elevated);
  }

  .type {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 70px;
    color: var(--text-muted);
  }

  .type-added {
    color: var(--accent);
  }

  .type-fixed {
    color: #22c55e;
  }

  .type-changed {
    color: #f59e0b;
  }

  .type-removed {
    color: #ef4444;
  }

  .type-planned {
    color: var(--text-muted);
  }

  .text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-16);
    text-align: center;
  }

  .empty-state p {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .changelog-page {
      padding: calc(var(--nav-height) + var(--space-10)) var(--space-4) var(--space-16);
    }

    .page-header h1 {
      font-size: var(--text-2xl);
    }

    .changes li {
      flex-direction: column;
      gap: var(--space-2);
    }

    .type {
      min-width: auto;
    }
  }
</style>
