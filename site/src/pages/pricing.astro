---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';

const features = [
  'The app, forever',
  '12 months of updates',
  'No feature restrictions',
  'Mac & Windows'
];

const faqs = [
  { q: 'What if you stop developing Readied?', a: "Your app keeps working. Your files are standard Markdown." },
  { q: 'Is there a subscription option?', a: "No. One-time purchases align incentives better." },
  { q: 'Can I export my data?', a: "Your data is Markdown files on your disk. Nothing to export." },
  { q: 'What about refunds?', a: "14-day money-back guarantee." }
];
---

<Base title="Pricing — Readied" description="One payment. No subscription.">
  <main class="pricing-page">
    <div class="container">
      <header class="page-header">
        <span class="label">Pricing</span>
        <h1>One payment.<br/><span class="text-gradient">No subscription.</span></h1>
      </header>

      <div class="pricing-layout">
        <div class="pricing-card glass">
          <div class="card-header">
            <div class="price">
              <span class="amount">$79</span>
              <span class="period">one-time</span>
            </div>
            <div class="price-badge glass-accent">Best value</div>
          </div>

          <ul class="features">
            {features.map((f) => (
              <li>
                <Icon name="lucide:check" size={16} class="icon-accent" />
                {f}
              </li>
            ))}
          </ul>

          <div class="renewal glass">
            <span class="renewal-label">Renewal</span>
            <p>After 12 months: $39/year for updates. App keeps working regardless.</p>
          </div>

          <a href="/download" class="btn btn-primary btn-lg" data-magnetic="0.2">
            <Icon name="lucide:download" size={20} />
            Start 14-day trial
          </a>

          <div class="card-glow"></div>
        </div>

        <section class="faq">
          <h2>Questions</h2>
          <div class="faq-list">
            {faqs.map(faq => (
              <details class="faq-item glass">
                <summary class="faq-question">
                  <span>{faq.q}</span>
                  <Icon name="lucide:chevron-down" size={20} class="chevron" />
                </summary>
                <p class="faq-answer">{faq.a}</p>
              </details>
            ))}
          </div>
          <a href="/faq" class="faq-more-link">
            View all FAQs
            <Icon name="lucide:arrow-right" size={14} />
          </a>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .pricing-page {
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-6) var(--space-24);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header .label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    line-height: 1.15;
  }

  .pricing-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .pricing-card {
    position: relative;
    padding: var(--space-8);
    overflow: hidden;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: var(--space-6);
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .amount {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--accent);
  }

  .period {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .price-badge {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    border-radius: var(--radius-full);
  }

  .features {
    list-style: none;
    margin-bottom: var(--space-6);
  }

  .features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    font-size: var(--text-base);
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
  }

  .features li:last-child {
    border-bottom: none;
  }

  .renewal {
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
  }

  .renewal-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .renewal p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .pricing-card .btn {
    width: 100%;
    justify-content: center;
    gap: var(--space-3);
  }

  .card-glow {
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
  }

  .faq h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .faq-item {
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question span {
    flex: 1;
  }

  .chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .faq-item[open] .chevron {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-question {
    border-bottom: 1px solid var(--glass-border);
  }

  .faq-answer {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    background: var(--glass-bg-dark);
    margin: 0;
  }

  .faq-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    transition: gap var(--duration-fast) var(--ease-out);
  }

  .faq-more-link:hover {
    gap: var(--space-3);
  }

  @media (max-width: 768px) {
    .pricing-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .pricing-page {
      padding: calc(var(--nav-height) + var(--space-10)) var(--space-4) var(--space-16);
    }

    .page-header h1 {
      font-size: var(--text-2xl);
    }

    .pricing-card {
      padding: var(--space-6);
    }
  }
</style>
